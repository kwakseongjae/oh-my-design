{
  "id": "harbor-berth-dispatch-review-v0.1",
  "version": "0.1.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "A harbor berth-dispatch review for port operations. Preserve six supplied vessel-call identifiers, eight tow-order identifiers, their exact call assignments, the separate pilot-window strip, three review views, draft-note setting, dispatch-review name, and summary facts without inventing berth clearance, pilot assignment, tug dispatch, arrival approval, maneuver safety, cargo release, or port outcomes.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": { "landmarks": { "h1_count": { "exact": 1 }, "main_count": { "exact": 1 }, "nav_count": { "min": 1 }, "footer_count": { "min": 1 } } },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='dispatch-view-option']", "[data-bench='draft-note-toggle']", "[data-bench='dispatch-review-form']", "[data-bench='dispatch-name']", "[data-bench='form-status']", "[data-bench='berth-call']", "[data-bench='vessel-call-id']", "[data-bench='tow-order-id']", "[data-bench='pilot-strip']", "[data-bench='pilot-station-id']", "[data-bench='pilot-window']", "[data-bench='compact-control-copy']", "[data-bench-design-role='berth-board']", "[data-bench-decision-role='context']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']", "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='dispatch-view-option']": 3,
    "[data-bench='draft-note-toggle']": 1,
    "[data-bench='dispatch-review-form']": 1,
    "[data-bench='dispatch-name']": 1,
    "[data-bench='form-status']": 1,
    "[data-bench='berth-call']": 6,
    "[data-bench='vessel-call-id']": 6,
    "[data-bench='tow-order-id']": 8,
    "[data-bench='pilot-strip']": 1,
    "[data-bench='pilot-station-id']": 4,
    "[data-bench='pilot-window']": 4,
    "[data-bench='compact-control-copy']": 1,
    "[data-bench-design-role='berth-board']": 1,
    "[data-bench-decision-role='context']": 1,
    "[data-bench-decision-role='target']": 1,
    "[data-bench-decision-role='evidence']": 1,
    "[data-bench-decision-role='state']": 1,
    "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": { "selector": "[data-bench='dispatch-view-option']", "value_attribute": "data-view", "body_dataset": "view", "values": ["berths", "pilots", "handoff"], "count": 3, "initial": "berths", "selected": "pilots" },
    "toggle": { "selector": "[data-bench='draft-note-toggle']" },
    "form": { "form_selector": "[data-bench='dispatch-review-form']", "field_selector": "[data-bench='dispatch-name']", "status_selector": "[data-bench='form-status']", "invalid_value": "", "valid_value": "Night watch dispatch review" }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench-design-role='berth-board']", "[data-bench='pilot-strip']", "[data-bench-decision-role='context']"],
    "atomic_scope_selectors": ["[data-bench='vessel-call-id']", "[data-bench='tow-order-id']", "[data-bench='pilot-station-id']", "[data-bench='pilot-window']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']"],
    "compact_copy_selectors": ["[data-bench='compact-control-copy']"],
    "max_short_text_chars": 48,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"],
    "minimum_action_gap_px": 8,
    "roles": { "container": "[data-bench-decision-role='context']", "target": "[data-bench-decision-role='target']", "evidence": "[data-bench-decision-role='evidence']", "state": "[data-bench-decision-role='state']", "action": "[data-bench-decision-role='action']" }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:berth cleared|pilot assigned|tug dispatched|arrival approved|maneuver safe|cargo released|port operation complete)\\b",
    "\\btrusted by\\b", "[★☆]{3,}"
  ],
  "protected_known_patterns": ["VC-NEPTUNE-204 + TOW-ORD-83018", "6 vessel calls · 8 tow orders · 4 pilot windows"],
  "protected_unknown_selectors": ["blockquote", "[class*='testimonial' i]", "[class*='logo-wall' i]", "[class*='social-proof' i]"],
  "design_oracle": {
    "page_background": "#F4F1EC", "primary_action": "#244A3B", "accent": "#B46332", "ink": "#202522", "surface": "#FFFEFA", "border": "#AAA99F", "muted_text": "#74756F", "card_radius_px": 0, "control_radius_px": 2,
    "font_family": { "body_any": ["Arial"], "display_any": ["Georgia"] },
    "selectors": { "primary_action": "[data-primary-action]", "card": "[data-bench-design-role='berth-board']", "display": "h1" }
  }
}
