{
  "id": "production-cue-dependency-review-v0.1",
  "version": "0.1.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "A production cue dependency review for show coordinators. Preserve supplied cue and predecessor identifiers, three lane memberships, seven dependency relationships, review views, source-note setting, review name, and summary facts without inventing rehearsal, safety, readiness, approval, staffing, equipment, timing, completion, or release outcomes or breaking atomic cue relationships on narrow screens.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": { "landmarks": { "h1_count": { "exact": 1 }, "main_count": { "exact": 1 }, "nav_count": { "min": 1 }, "footer_count": { "min": 1 } } },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='review-view-option']", "[data-bench='source-note-toggle']", "[data-bench='cue-review-form']", "[data-bench='review-name']", "[data-bench='form-status']", "[data-bench='cue-lane']", "[data-bench='lane-name']", "[data-bench='cue-card']", "[data-bench='cue-id']", "[data-bench='predecessor-id']", "[data-bench='dependency-link']", "[data-bench='compact-control-copy']", "[data-bench-design-role='cue-dependency-board']", "[data-bench-decision-role='context']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']", "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='review-view-option']": 3,
    "[data-bench='source-note-toggle']": 1,
    "[data-bench='cue-review-form']": 1,
    "[data-bench='review-name']": 1,
    "[data-bench='form-status']": 1,
    "[data-bench='cue-lane']": 3,
    "[data-bench='lane-name']": 3,
    "[data-bench='cue-card']": 8,
    "[data-bench='cue-id']": 8,
    "[data-bench='predecessor-id']": 7,
    "[data-bench='dependency-link']": 7,
    "[data-bench='compact-control-copy']": 1,
    "[data-bench-design-role='cue-dependency-board']": 1,
    "[data-bench-decision-role='context']": 1,
    "[data-bench-decision-role='target']": 1,
    "[data-bench-decision-role='evidence']": 1,
    "[data-bench-decision-role='state']": 1,
    "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": { "selector": "[data-bench='review-view-option']", "value_attribute": "data-view", "body_dataset": "view", "values": ["all", "dependencies", "handoff"], "count": 3, "initial": "all", "selected": "dependencies" },
    "toggle": { "selector": "[data-bench='source-note-toggle']" },
    "form": { "form_selector": "[data-bench='cue-review-form']", "field_selector": "[data-bench='review-name']", "status_selector": "[data-bench='form-status']", "invalid_value": "", "valid_value": "Act two cue review" }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench='cue-lane']", "[data-bench-decision-role='context']"],
    "atomic_scope_selectors": ["[data-bench='lane-name']", "[data-bench='cue-id']", "[data-bench='predecessor-id']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']"],
    "compact_copy_selectors": ["[data-bench='compact-control-copy']"],
    "max_short_text_chars": 42,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"],
    "minimum_action_gap_px": 8,
    "roles": { "container": "[data-bench-decision-role='context']", "target": "[data-bench-decision-role='target']", "evidence": "[data-bench-decision-role='evidence']", "state": "[data-bench-decision-role='state']", "action": "[data-bench-decision-role='action']" }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:rehearsed|safe|ready|approved|staffed|equipment confirmed|timing confirmed|completed|release ready)\\b",
    "\\btrusted by\\b", "[★☆]{3,}"
  ],
  "protected_known_patterns": ["ACT-02 · AUDIO-C17 to STAGE-CUE-42", "8 cues · 7 dependencies · 3 named lanes"],
  "protected_unknown_selectors": ["blockquote", "[class*='testimonial' i]", "[class*='logo-wall' i]", "[class*='social-proof' i]"],
  "design_oracle": {
    "page_background": "#F4F0E8", "primary_action": "#24423C", "accent": "#C7653C", "ink": "#1C2422", "surface": "#FFFCF6", "border": "#AAB1AD", "muted_text": "#68716D", "card_radius_px": 0, "control_radius_px": 2,
    "font_family": { "body_any": ["Arial"], "display_any": ["Georgia"] },
    "selectors": { "primary_action": "[data-primary-action]", "card": "[data-bench-design-role='cue-dependency-board']", "display": "h1" }
  }
}
