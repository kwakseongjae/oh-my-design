    "[data-bench='conflict-note-toggle']": 1,
    "[data-bench='contact-review-form']": 1,
    "[data-bench='contact-name']": 1,
    "[data-bench='form-status']": 1,
    "[data-bench='contact-window']": 6,
    "[data-bench='pass-id']": 6,
    "[data-bench='command-bundle-id']": 8,
    "[data-bench='antenna-strip']": 1,
    "[data-bench='antenna-id']": 4,
    "[data-bench='link-window']": 4,
    "[data-bench='compact-control-copy']": 1,
    "[data-bench-design-role='contact-plan']": 1,
    "[data-bench-decision-role='context']": 1,
    "[data-bench-decision-role='target']": 1,
    "[data-bench-decision-role='evidence']": 1,
    "[data-bench-decision-role='state']": 1,
    "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": { "selector": "[data-bench='contact-view-option']", "value_attribute": "data-view", "body_dataset": "view", "values": ["schedule", "antennas", "handoff"], "count": 3, "initial": "schedule", "selected": "antennas" },
    "toggle": { "selector": "[data-bench='conflict-note-toggle']" },
    "form": { "form_selector": "[data-bench='contact-review-form']", "field_selector": "[data-bench='contact-name']", "status_selector": "[data-bench='form-status']", "invalid_value": "", "valid_value": "Orbit 18 contact review" }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench-design-role='contact-plan']", "[data-bench='antenna-strip']", "[data-bench-decision-role='context']"],
    "atomic_scope_selectors": ["[data-bench='pass-id']", "[data-bench='command-bundle-id']", "[data-bench='antenna-id']", "[data-bench='link-window']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']"],
    "compact_copy_selectors": ["[data-bench='compact-control-copy']"],
    "max_short_text_chars": 48,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"],
    "minimum_action_gap_px": 8,
    "roles": { "container": "[data-bench-decision-role='context']", "target": "[data-bench-decision-role='target']", "evidence": "[data-bench-decision-role='evidence']", "state": "[data-bench-decision-role='state']", "action": "[data-bench-decision-role='action']" }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:orbit validated|command authorized|antenna booked|link ready|mission approved|execution complete|safe|spacecraft cleared)\\b",
