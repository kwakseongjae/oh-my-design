  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='contact-view-option']", "[data-bench='conflict-note-toggle']", "[data-bench='contact-review-form']", "[data-bench='contact-name']", "[data-bench='form-status']", "[data-bench='contact-window']", "[data-bench='pass-id']", "[data-bench='command-bundle-id']", "[data-bench='antenna-strip']", "[data-bench='antenna-id']", "[data-bench='link-window']", "[data-bench='compact-control-copy']", "[data-bench-design-role='contact-plan']", "[data-bench-decision-role='context']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']", "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
