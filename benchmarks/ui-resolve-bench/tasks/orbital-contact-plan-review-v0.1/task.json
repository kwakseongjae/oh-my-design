  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "An orbital contact-plan review for mission planning. Preserve six supplied pass identifiers, eight command-bundle identifiers, their exact pass assignments, the separate antenna availability strip, three review views, conflict-note setting, contact-review name, and summary facts without inventing orbit validation, command authorization, antenna booking, link readiness, mission approval, execution, safety, or spacecraft outcomes.",
  "network": "disabled",
  "entry": "index.html",
