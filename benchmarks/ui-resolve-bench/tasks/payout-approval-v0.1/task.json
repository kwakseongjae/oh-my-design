{
  "id": "payout-approval-v0.1",
  "version": "0.2.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "approval-v1",
  "review_brief": "A payout-approval queue for a small marketplace operations team. Compare whether the result keeps payee, amount, timing, evidence, status, and the irreversible approval decision legible without turning financial review into decorative dashboard theatre.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": {
    "landmarks": {
      "h1_count": { "exact": 1 },
      "main_count": { "exact": 1 },
      "nav_count": { "min": 1 },
      "footer_count": { "min": 1 }
    }
  },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='filter-button']",
    "[data-bench='approval-row']",
    "[data-bench='details-button']",
    "[data-bench='open-approval']",
    "[data-bench='approval-dialog']",
    "[data-bench='cancel-approval']",
    "[data-bench='confirm-approval']",
    "[data-bench='operation-status']",
    "[data-bench-design-role='main-console']",
    "[data-bench-decision-role='context']",
    "[data-bench-decision-role='target']",
    "[data-bench-decision-role='evidence']",
    "[data-bench-decision-role='state']",
    "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='filter-button']": 3,
    "[data-bench='approval-row']": 4,
    "[data-bench='details-button']": 2,
    "[data-bench='open-approval']": 1,
    "[data-bench='approval-dialog']": { "total": 1, "visible": 0 },
    "[data-bench='cancel-approval']": { "total": 1, "visible": 0 },
    "[data-bench='confirm-approval']": { "total": 1, "visible": 0 },
    "[data-bench='operation-status']": 1,
    "[data-bench-design-role='main-console']": 1,
    "[data-bench-decision-role='context']": 1,
    "[data-bench-decision-role='target']": 1,
    "[data-bench-decision-role='evidence']": 1,
    "[data-bench-decision-role='state']": 1,
    "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "filter": {
      "selector": "[data-bench='filter-button']",
      "value_attribute": "data-filter",
      "body_dataset": "filter",
      "row_selector": "[data-bench='approval-row']",
      "count": 3,
      "initial": "all",
      "selected": "review",
      "initial_visible_rows": 4,
      "selected_visible_rows": 2
    },
    "disclosure": {
      "selector": "[data-bench='details-button']",
      "count": 2
    },
    "decision": {
      "open_button_selector": "[data-bench='open-approval']",
      "dialog_selector": "[data-bench='approval-dialog']",
      "cancel_button_selector": "[data-bench='cancel-approval']",
      "confirm_button_selector": "[data-bench='confirm-approval']",
      "status_selector": "[data-bench='operation-status']"
    }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench='approval-row']", "[data-bench-decision-role='context']"],
    "max_short_text_chars": 24,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"],
    "minimum_action_gap_px": 8,
    "roles": {
      "container": "[data-bench-decision-role='context']",
      "target": "[data-bench-decision-role='target']",
      "evidence": "[data-bench-decision-role='evidence']",
      "state": "[data-bench-decision-role='state']",
      "action": "[data-bench-decision-role='action']"
    }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:best|fastest|leading|top-rated|award-winning)\\s+(?:payout|payment|finance|operations|tool|platform)\\b",
    "\\btrusted by\\b",
    "\\b(?:zero fraud|always secure|instant settlement|risk-free)\\b",
    "\\b\\d[\\d,]*\\+?\\s+(?:customers|companies|sellers|vendors|users|reviews|payouts)\\b",
    "[★☆]{3,}"
  ],
  "protected_known_patterns": [
    "Four payout batches are ready for review",
    "Invoice MARKET-208 covers the June produce delivery"
  ],
  "protected_unknown_selectors": [
    "blockquote",
    "[class*='testimonial' i]",
    "[class*='logo-wall' i]",
    "[class*='social-proof' i]"
  ],
  "design_oracle": {
    "page_background": "#F4F1EB",
    "primary_action": "#394D8A",
    "accent": "#B45D34",
    "ink": "#20231F",
    "surface": "#FFFFFF",
    "border": "#D8D2C8",
    "muted_text": "#61665F",
    "card_radius_px": 10,
    "control_radius_px": 6,
    "font_family": {
      "body_any": ["Arial"],
      "display_any": ["Georgia"]
    },
    "selectors": {
      "primary_action": "[data-bench='confirm-approval']",
      "card": "[data-bench-design-role='main-console']",
      "display": "h1"
    }
  }
}
