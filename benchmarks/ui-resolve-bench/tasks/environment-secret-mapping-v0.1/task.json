{
  "id": "environment-secret-mapping-v0.1",
  "version": "0.1.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "An environment-secret mapping surface for a release operations team. Compare whether the result keeps supplied secret identifiers, target environment, inheritance policy, mapping label, and final review action legible without inventing validation or breaking atomic identifiers on narrow screens.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": { "landmarks": { "h1_count": { "exact": 1 }, "main_count": { "exact": 1 }, "nav_count": { "min": 1 }, "footer_count": { "min": 1 } } },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 }, { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 }, { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='role-option']", "[data-bench='digest-toggle']", "[data-bench='workspace-form']", "[data-bench='workspace-name']", "[data-bench='form-status']", "[data-bench='mapping-row']",
    "[data-bench-design-role='mapping-console']", "[data-bench-decision-role='context']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']", "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='role-option']": 3, "[data-bench='digest-toggle']": 1, "[data-bench='workspace-form']": 1, "[data-bench='workspace-name']": 1, "[data-bench='form-status']": 1, "[data-bench='mapping-row']": 3,
    "[data-bench-design-role='mapping-console']": 1, "[data-bench-decision-role='context']": 1, "[data-bench-decision-role='target']": 1, "[data-bench-decision-role='evidence']": 1, "[data-bench-decision-role='state']": 1, "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": { "selector": "[data-bench='role-option']", "value_attribute": "data-role", "body_dataset": "role", "values": ["preview", "staging", "production"], "count": 3, "initial": "preview", "selected": "staging" },
    "toggle": { "selector": "[data-bench='digest-toggle']" },
    "form": { "form_selector": "[data-bench='workspace-form']", "field_selector": "[data-bench='workspace-name']", "status_selector": "[data-bench='form-status']", "invalid_value": "", "valid_value": "August release mapping" }
  },
  "text_geometry_oracle": { "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"], "scope_selectors": ["[data-bench='mapping-row']", "[data-bench-decision-role='context']"], "max_short_text_chars": 28, "max_short_text_lines": 1 },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"], "minimum_action_gap_px": 8,
    "roles": { "container": "[data-bench-decision-role='context']", "target": "[data-bench-decision-role='target']", "evidence": "[data-bench-decision-role='evidence']", "state": "[data-bench-decision-role='state']", "action": "[data-bench-decision-role='action']" }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:best|fastest|leading|top-rated|award-winning)\\s+(?:secret|release|mapping|deployment|tool|platform)\\b", "\\btrusted by\\b",
    "\\b(?:zero risk|fully validated|instant deployment|always safe|perfect mapping)\\b", "\\b\\d[\\d,]*\\+?\\s+(?:customers|companies|deployments|secrets|keys)\\b", "[★☆]{3,}"
  ],
  "protected_known_patterns": ["PAYMENTS_API_KEY_V4", "3 supplied secrets · 1 target environment"],
  "protected_unknown_selectors": ["blockquote", "[class*='testimonial' i]", "[class*='logo-wall' i]", "[class*='social-proof' i]"],
  "design_oracle": {
    "page_background": "#F3F1ED", "primary_action": "#3D526B", "accent": "#A65B43", "ink": "#202A35", "surface": "#FFFFFF", "border": "#C9D0D6", "muted_text": "#596673",
    "card_radius_px": 8, "control_radius_px": 4, "font_family": { "body_any": ["Arial"], "display_any": ["Georgia"] },
    "selectors": { "primary_action": "[data-primary-action]", "card": "[data-bench-design-role='mapping-console']", "display": "h1" }
  }
}
