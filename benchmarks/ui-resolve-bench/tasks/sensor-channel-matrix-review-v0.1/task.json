{
  "id": "sensor-channel-matrix-review-v0.1",
  "version": "0.1.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "A cross-matrix review for a field-systems team. Preserve supplied channel identifiers, gateway identifiers, compatibility values, matrix view, reserved-note setting, review name, and summary facts without inventing connection, calibration, telemetry, safety, approval, observation, quality, or release outcomes or breaking atomic matrix relationships on narrow screens.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": { "landmarks": { "h1_count": { "exact": 1 }, "main_count": { "exact": 1 }, "nav_count": { "min": 1 }, "footer_count": { "min": 1 } } },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='matrix-view-option']", "[data-bench='reserved-toggle']", "[data-bench='matrix-form']", "[data-bench='review-name']", "[data-bench='form-status']",
    "[data-bench='matrix-row']", "[data-bench='matrix-cell']", "[data-bench='channel-id']", "[data-bench='gateway-id']", "[data-bench='compact-control-copy']",
    "[data-bench-design-role='channel-matrix']", "[data-bench-decision-role='context']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']", "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='matrix-view-option']": 3, "[data-bench='reserved-toggle']": 1, "[data-bench='matrix-form']": 1, "[data-bench='review-name']": 1, "[data-bench='form-status']": 1,
    "[data-bench='matrix-row']": 5, "[data-bench='matrix-cell']": 20, "[data-bench='channel-id']": 5, "[data-bench='gateway-id']": 4, "[data-bench='compact-control-copy']": 1,
    "[data-bench-design-role='channel-matrix']": 1, "[data-bench-decision-role='context']": 1, "[data-bench-decision-role='target']": 1, "[data-bench-decision-role='evidence']": 1, "[data-bench-decision-role='state']": 1, "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": { "selector": "[data-bench='matrix-view-option']", "value_attribute": "data-view", "body_dataset": "view", "values": ["coverage", "protocol", "power"], "count": 3, "initial": "coverage", "selected": "protocol" },
    "toggle": { "selector": "[data-bench='reserved-toggle']" },
    "form": { "form_selector": "[data-bench='matrix-form']", "field_selector": "[data-bench='review-name']", "status_selector": "[data-bench='form-status']", "invalid_value": "", "valid_value": "North array matrix review" }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench-design-role='channel-matrix']", "[data-bench-decision-role='context']"],
    "atomic_scope_selectors": ["[data-bench='channel-id']", "[data-bench='gateway-id']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']"],
    "compact_copy_selectors": ["[data-bench='compact-control-copy']"],
    "max_short_text_chars": 40,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"], "minimum_action_gap_px": 8,
    "roles": { "container": "[data-bench-decision-role='context']", "target": "[data-bench-decision-role='target']", "evidence": "[data-bench-decision-role='evidence']", "state": "[data-bench-decision-role='state']", "action": "[data-bench-decision-role='action']" }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:connection confirmed|channels calibrated|telemetry verified|safety checked|matrix approved|quality passed|release ready)\\b", "\\btrusted by\\b", "[★☆]{3,}"
  ],
  "protected_known_patterns": ["MX-NORTH-14 · ARRAY-03", "5 channels · 4 gateways · 20 supplied relationships"],
  "protected_unknown_selectors": ["blockquote", "[class*='testimonial' i]", "[class*='logo-wall' i]", "[class*='social-proof' i]"],
  "design_oracle": {
    "page_background": "#F3F1EA", "primary_action": "#173F3A", "accent": "#D96A3A", "ink": "#17211F", "surface": "#FCFBF7", "border": "#A9B2AC", "muted_text": "#66716C",
    "card_radius_px": 0, "control_radius_px": 2, "font_family": { "body_any": ["Arial"], "display_any": ["Georgia"] },
    "selectors": { "primary_action": "[data-primary-action]", "card": "[data-bench-design-role='channel-matrix']", "display": "h1" }
  }
}
