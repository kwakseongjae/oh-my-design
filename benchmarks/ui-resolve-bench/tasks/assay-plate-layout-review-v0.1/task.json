{
  "id": "assay-plate-layout-review-v0.1",
  "version": "0.1.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "A spatial assay-plate layout review for a research operations team. Preserve supplied well coordinates, sample identifiers, control roles, plate format, orientation, edge-well setting, review-set name, and summary facts without inventing assay, sample, calibration, quality, safety, approval, analysis, or release outcomes or breaking atomic well/sample pairs on narrow screens.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": { "landmarks": { "h1_count": { "exact": 1 }, "main_count": { "exact": 1 }, "nav_count": { "min": 1 }, "footer_count": { "min": 1 } } },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='plate-format-option']", "[data-bench='edge-toggle']", "[data-bench='plate-form']", "[data-bench='review-set-name']", "[data-bench='form-status']",
    "[data-bench='well-item']", "[data-bench='well-coordinate']", "[data-bench='sample-identity']", "[data-bench='compact-control-copy']",
    "[data-bench-design-role='plate-map']", "[data-bench-decision-role='context']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']", "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='plate-format-option']": 3, "[data-bench='edge-toggle']": 1, "[data-bench='plate-form']": 1, "[data-bench='review-set-name']": 1, "[data-bench='form-status']": 1,
    "[data-bench='well-item']": 12, "[data-bench='well-coordinate']": 12, "[data-bench='sample-identity']": 12, "[data-bench='compact-control-copy']": 1,
    "[data-bench-design-role='plate-map']": 1, "[data-bench-decision-role='context']": 1, "[data-bench-decision-role='target']": 1, "[data-bench-decision-role='evidence']": 1, "[data-bench-decision-role='state']": 1, "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": { "selector": "[data-bench='plate-format-option']", "value_attribute": "data-format", "body_dataset": "format", "values": ["96-well", "384-well", "custom"], "count": 3, "initial": "96-well", "selected": "384-well" },
    "toggle": { "selector": "[data-bench='edge-toggle']" },
    "form": { "form_selector": "[data-bench='plate-form']", "field_selector": "[data-bench='review-set-name']", "status_selector": "[data-bench='form-status']", "invalid_value": "", "valid_value": "Plate 7 layout review" }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench='well-item']", "[data-bench-decision-role='context']"],
    "atomic_scope_selectors": ["[data-bench='well-coordinate']", "[data-bench='sample-identity']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']"],
    "compact_copy_selectors": ["[data-bench='compact-control-copy']"],
    "max_short_text_chars": 40,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"], "minimum_action_gap_px": 8,
    "roles": { "container": "[data-bench-decision-role='context']", "target": "[data-bench-decision-role='target']", "evidence": "[data-bench-decision-role='evidence']", "state": "[data-bench-decision-role='state']", "action": "[data-bench-decision-role='action']" }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:assay passed|samples validated|controls approved|calibration complete|quality confirmed|analysis ready|release approved)\\b", "\\btrusted by\\b", "[★☆]{3,}"
  ],
  "protected_known_patterns": ["PLT-07 · Batch BX-2408", "12 supplied wells · 8 samples · 4 controls"],
  "protected_unknown_selectors": ["blockquote", "[class*='testimonial' i]", "[class*='logo-wall' i]", "[class*='social-proof' i]"],
  "design_oracle": {
    "page_background": "#F3F1EA", "primary_action": "#173F3A", "accent": "#D96A3A", "ink": "#17211F", "surface": "#FCFBF7", "border": "#A9B2AC", "muted_text": "#66716C",
    "card_radius_px": 0, "control_radius_px": 2, "font_family": { "body_any": ["Arial"], "display_any": ["Georgia"] },
    "selectors": { "primary_action": "[data-primary-action]", "card": "[data-bench-design-role='plate-map']", "display": "h1" }
  }
}
