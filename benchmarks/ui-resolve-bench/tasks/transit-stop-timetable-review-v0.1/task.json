{
  "id": "transit-stop-timetable-review-v0.1",
  "version": "0.1.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "A stop timetable review for a transit dispatch team. Preserve supplied service identifiers, stop identifiers, times, timetable view, express-note setting, review name, and summary facts without inventing delay, safety, accessibility, approval, passenger, capacity, maintenance, connection, or release outcomes or breaking atomic timetable relationships on narrow screens.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": { "landmarks": { "h1_count": { "exact": 1 }, "main_count": { "exact": 1 }, "nav_count": { "min": 1 }, "footer_count": { "min": 1 } } },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='timetable-view-option']", "[data-bench='express-toggle']", "[data-bench='timetable-form']", "[data-bench='review-name']", "[data-bench='form-status']",
    "[data-bench='service-row']", "[data-bench='time-cell']", "[data-bench='service-id']", "[data-bench='stop-id']", "[data-bench='compact-control-copy']",
    "[data-bench-design-role='timetable']", "[data-bench-decision-role='context']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']", "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='timetable-view-option']": 3, "[data-bench='express-toggle']": 1, "[data-bench='timetable-form']": 1, "[data-bench='review-name']": 1, "[data-bench='form-status']": 1,
    "[data-bench='service-row']": 4, "[data-bench='time-cell']": 20, "[data-bench='service-id']": 4, "[data-bench='stop-id']": 5, "[data-bench='compact-control-copy']": 1,
    "[data-bench-design-role='timetable']": 1, "[data-bench-decision-role='context']": 1, "[data-bench-decision-role='target']": 1, "[data-bench-decision-role='evidence']": 1, "[data-bench-decision-role='state']": 1, "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": { "selector": "[data-bench='timetable-view-option']", "value_attribute": "data-view", "body_dataset": "view", "values": ["arrival", "dwell", "platform"], "count": 3, "initial": "arrival", "selected": "dwell" },
    "toggle": { "selector": "[data-bench='express-toggle']" },
    "form": { "form_selector": "[data-bench='timetable-form']", "field_selector": "[data-bench='review-name']", "status_selector": "[data-bench='form-status']", "invalid_value": "", "valid_value": "North loop timetable review" }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench-design-role='timetable']", "[data-bench-decision-role='context']"],
    "atomic_scope_selectors": ["[data-bench='service-id']", "[data-bench='stop-id']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']"],
    "compact_copy_selectors": ["[data-bench='compact-control-copy']"],
    "max_short_text_chars": 40,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"], "minimum_action_gap_px": 8,
    "roles": { "container": "[data-bench-decision-role='context']", "target": "[data-bench-decision-role='target']", "evidence": "[data-bench-decision-role='evidence']", "state": "[data-bench-decision-role='state']", "action": "[data-bench-decision-role='action']" }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:on time|delay cleared|safety checked|accessibility verified|timetable approved|capacity confirmed|release ready)\\b", "\\btrusted by\\b", "[★☆]{3,}"
  ],
  "protected_known_patterns": ["TT-NORTH-22 · LOOP-05", "4 services · 5 stops · 20 supplied times"],
  "protected_unknown_selectors": ["blockquote", "[class*='testimonial' i]", "[class*='logo-wall' i]", "[class*='social-proof' i]"],
  "design_oracle": {
    "page_background": "#F3F1EA", "primary_action": "#173F3A", "accent": "#D96A3A", "ink": "#17211F", "surface": "#FCFBF7", "border": "#A9B2AC", "muted_text": "#66716C",
    "card_radius_px": 0, "control_radius_px": 2, "font_family": { "body_any": ["Arial"], "display_any": ["Georgia"] },
    "selectors": { "primary_action": "[data-primary-action]", "card": "[data-bench-design-role='timetable']", "display": "h1" }
  }
}
