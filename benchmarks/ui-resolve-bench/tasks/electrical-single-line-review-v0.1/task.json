{
  "id": "electrical-single-line-review-v0.1",
  "version": "0.1.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "An electrical single-line drawing review for facilities planners. Preserve supplied source, breaker, bus, branch, and load identifiers; diagram relationships; review views; annotation setting; review name; and summary facts without inventing energized, isolated, compliant, approved, safe, redundant, commissioned, capacity, protection, maintenance, or release outcomes or breaking atomic electrical relationships on narrow screens.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": { "landmarks": { "h1_count": { "exact": 1 }, "main_count": { "exact": 1 }, "nav_count": { "min": 1 }, "footer_count": { "min": 1 } } },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='diagram-view-option']", "[data-bench='annotation-toggle']", "[data-bench='single-line-form']", "[data-bench='review-name']", "[data-bench='form-status']", "[data-bench='electrical-node']", "[data-bench='node-id']", "[data-bench='electrical-connector']", "[data-bench='branch-id']", "[data-bench='compact-control-copy']", "[data-bench-design-role='single-line-diagram']", "[data-bench-decision-role='context']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']", "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='diagram-view-option']": 3,
    "[data-bench='annotation-toggle']": 1,
    "[data-bench='single-line-form']": 1,
    "[data-bench='review-name']": 1,
    "[data-bench='form-status']": 1,
    "[data-bench='electrical-node']": 8,
    "[data-bench='node-id']": 8,
    "[data-bench='electrical-connector']": 7,
    "[data-bench='branch-id']": 4,
    "[data-bench='compact-control-copy']": 1,
    "[data-bench-design-role='single-line-diagram']": 1,
    "[data-bench-decision-role='context']": 1,
    "[data-bench-decision-role='target']": 1,
    "[data-bench-decision-role='evidence']": 1,
    "[data-bench-decision-role='state']": 1,
    "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": { "selector": "[data-bench='diagram-view-option']", "value_attribute": "data-view", "body_dataset": "view", "values": ["overview", "protection", "loads"], "count": 3, "initial": "overview", "selected": "protection" },
    "toggle": { "selector": "[data-bench='annotation-toggle']" },
    "form": { "form_selector": "[data-bench='single-line-form']", "field_selector": "[data-bench='review-name']", "status_selector": "[data-bench='form-status']", "invalid_value": "", "valid_value": "East feeder drawing review" }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench-design-role='single-line-diagram']", "[data-bench-decision-role='context']"],
    "atomic_scope_selectors": ["[data-bench='node-id']", "[data-bench='branch-id']", "[data-bench-decision-role='target']", "[data-bench-decision-role='evidence']", "[data-bench-decision-role='state']"],
    "compact_copy_selectors": ["[data-bench='compact-control-copy']"],
    "max_short_text_chars": 40,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"],
    "minimum_action_gap_px": 8,
    "roles": { "container": "[data-bench-decision-role='context']", "target": "[data-bench-decision-role='target']", "evidence": "[data-bench-decision-role='evidence']", "state": "[data-bench-decision-role='state']", "action": "[data-bench-decision-role='action']" }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:energized|isolated|compliant|drawing approved|electrically safe|redundancy verified|commissioned|capacity confirmed|protection verified|maintenance complete|release ready)\\b",
    "\\btrusted by\\b", "[★☆]{3,}"
  ],
  "protected_known_patterns": ["SLD-EAST-07 · SRC-A to BUS-E07", "8 nodes · 7 connections · 4 load branches"],
  "protected_unknown_selectors": ["blockquote", "[class*='testimonial' i]", "[class*='logo-wall' i]", "[class*='social-proof' i]"],
  "design_oracle": {
    "page_background": "#F4F0E8", "primary_action": "#24423C", "accent": "#C7653C", "ink": "#1C2422", "surface": "#FFFCF6", "border": "#AAB1AD", "muted_text": "#68716D", "card_radius_px": 0, "control_radius_px": 2,
    "font_family": { "body_any": ["Arial"], "display_any": ["Georgia"] },
    "selectors": { "primary_action": "[data-primary-action]", "card": "[data-bench-design-role='single-line-diagram']", "display": "h1" }
  }
}
