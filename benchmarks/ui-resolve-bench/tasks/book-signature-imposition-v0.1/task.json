{
  "id": "book-signature-imposition-v0.1",
  "version": "0.1.0",
  "track": "repair",
  "grounding": "design-md",
  "locale": "en",
  "behavior_adapter": "onboarding-v1",
  "review_brief": "A book-signature imposition review surface. Preserve supplied signature, sheet-side, folio-pair, trim, binding, compensation, job-name, and final review facts without inventing print, approval, pagination, color, production, or delivery outcomes or breaking atomic values on narrow screens.",
  "network": "disabled",
  "entry": "index.html",
  "semantic_oracle": {
    "landmarks": {
      "h1_count": { "exact": 1 },
      "main_count": { "exact": 1 },
      "nav_count": { "min": 1 },
      "footer_count": { "min": 1 }
    }
  },
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "narrow-320", "width": 320, "height": 720 },
    { "name": "css-zoom-surrogate-200", "width": 640, "height": 900, "zoom": 2 }
  ],
  "protected_selectors": [
    "[data-bench='binding-option']",
    "[data-bench='creep-toggle']",
    "[data-bench='imposition-form']",
    "[data-bench='job-name']",
    "[data-bench='form-status']",
    "[data-bench='folio-pair']",
    "[data-bench='compact-control-copy']",
    "[data-bench-design-role='signature-sheet']",
    "[data-bench-decision-role='context']",
    "[data-bench-decision-role='target']",
    "[data-bench-decision-role='evidence']",
    "[data-bench-decision-role='state']",
    "[data-bench-decision-role='action']"
  ],
  "protected_hook_counts": {
    "[data-bench='binding-option']": 3,
    "[data-bench='creep-toggle']": 1,
    "[data-bench='imposition-form']": 1,
    "[data-bench='job-name']": 1,
    "[data-bench='form-status']": 1,
    "[data-bench='folio-pair']": 4,
    "[data-bench='compact-control-copy']": 1,
    "[data-bench-design-role='signature-sheet']": 1,
    "[data-bench-decision-role='context']": 1,
    "[data-bench-decision-role='target']": 1,
    "[data-bench-decision-role='evidence']": 1,
    "[data-bench-decision-role='state']": 1,
    "[data-bench-decision-role='action']": 1
  },
  "journey_oracle": {
    "choice": {
      "selector": "[data-bench='binding-option']",
      "value_attribute": "data-binding",
      "body_dataset": "binding",
      "values": ["sewn", "perfect", "saddle"],
      "count": 3,
      "initial": "sewn",
      "selected": "perfect"
    },
    "toggle": { "selector": "[data-bench='creep-toggle']" },
    "form": {
      "form_selector": "[data-bench='imposition-form']",
      "field_selector": "[data-bench='job-name']",
      "status_selector": "[data-bench='form-status']",
      "invalid_value": "",
      "valid_value": "Atlas field guide signature"
    }
  },
  "text_geometry_oracle": {
    "viewports": ["mobile", "narrow-320", "css-zoom-surrogate-200"],
    "scope_selectors": ["[data-bench='folio-pair']", "[data-bench-decision-role='context']"],
    "atomic_scope_selectors": [
      "[data-bench='folio-pair']",
      "[data-bench-decision-role='target']",
      "[data-bench-decision-role='evidence']",
      "[data-bench-decision-role='state']"
    ],
    "compact_copy_selectors": ["[data-bench='compact-control-copy']"],
    "max_short_text_chars": 40,
    "max_short_text_lines": 1
  },
  "decision_hierarchy_oracle": {
    "viewports": ["desktop", "mobile", "narrow-320", "css-zoom-surrogate-200"],
    "minimum_action_gap_px": 8,
    "roles": {
      "container": "[data-bench-decision-role='context']",
      "target": "[data-bench-decision-role='target']",
      "evidence": "[data-bench-decision-role='evidence']",
      "state": "[data-bench-decision-role='state']",
      "action": "[data-bench-decision-role='action']"
    }
  },
  "protected_unknown_patterns": [
    "\\b(?:10x|99(?:\\.9)?%|guaranteed|revolutionary|supercharge|magical|seamless)\\b",
    "\\b(?:print approved|press ready|pagination verified|color certified|delivery confirmed)\\b",
    "\\btrusted by\\b",
    "[★☆]{3,}"
  ],
  "protected_known_patterns": ["signature-s04-front", "4 supplied folio pairs · trim 148 × 210 mm"],
  "protected_unknown_selectors": ["blockquote", "[class*='testimonial' i]", "[class*='logo-wall' i]", "[class*='social-proof' i]"],
  "design_oracle": {
    "page_background": "#EFECE5",
    "primary_action": "#253A33",
    "accent": "#A64632",
    "ink": "#202522",
    "surface": "#FFFEFA",
    "border": "#C8C2B7",
    "muted_text": "#666861",
    "card_radius_px": 0,
    "control_radius_px": 2,
    "font_family": { "body_any": ["Arial"], "display_any": ["Georgia"] },
    "selectors": {
      "primary_action": "[data-primary-action]",
      "card": "[data-bench-design-role='signature-sheet']",
      "display": "h1"
    }
  }
}
